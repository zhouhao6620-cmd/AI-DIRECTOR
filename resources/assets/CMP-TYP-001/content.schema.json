{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TypeShiftContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["lines"],
  "properties": {
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
    }
  }
}
