{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PunchPillContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "text": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
  }
}
