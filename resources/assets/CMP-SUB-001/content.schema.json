{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SubtitleTrackContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["cues"],
  "properties": {
    "cues": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "startMs", "endMs", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
          "translation": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
        }
      }
    }
  }
}
