{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GaugeDialContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["value"],
  "properties": {
    "value": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
    "min": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
    "max": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
    "unit": {"type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"},
    "label": {"type": "string", "maxLength": 12, "pattern": "^[^\\r\\n\\t]*$"},
    "tickCount": {"type": "integer", "minimum": 0, "maximum": 12, "not": {"const": 1}}
  }
}
