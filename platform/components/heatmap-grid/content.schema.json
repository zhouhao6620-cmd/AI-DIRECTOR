{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HeatmapGridContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["cells"],
  "properties": {
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 7,
        "items": {"type": "number", "minimum": 0, "maximum": 1000000000}
      }
    },
    "rowLabels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {"type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"}
    },
    "columnLabels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "items": {"type": "string", "maxLength": 3, "pattern": "^[^\\r\\n\\t]*$"}
    },
    "maxValue": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000},
    "showLegend": {"type": "boolean"}
  }
}
