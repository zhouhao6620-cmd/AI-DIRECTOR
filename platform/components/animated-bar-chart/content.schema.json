{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AnimatedBarChartContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["bars"],
  "properties": {
    "title": {
      "type": "string", "maxLength": 14, "pattern": "^[^\\r\\n\\t]*$"
    },
    "subtitle": {
      "type": "string", "maxLength": 20, "pattern": "^[^\\r\\n\\t]*$"
    },
    "unit": {
      "type": "string", "maxLength": 4, "pattern": "^[^\\r\\n\\t]*$"
    },
    "bars": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "value"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
          "value": {"type": "number", "minimum": 0, "maximum": 1000000000},
          "delta": {"type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"},
          "emphasis": {"type": "boolean"}
        }
      }
    },
    "caption": {
      "type": "string", "maxLength": 28, "pattern": "^[^\\r\\n\\t]*$"
    }
  }
}
