{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UICalloutContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["label"],
  "properties": {
    "label": {"type": "string", "minLength": 1, "maxLength": 36, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
  }
}
