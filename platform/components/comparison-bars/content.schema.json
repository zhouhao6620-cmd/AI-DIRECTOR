{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ComparisonBarsContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "title": {
      "type": "string", "maxLength": 14, "pattern": "^[^\\r\\n\\t]*$"
    },
    "beforeLabel": {
      "type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"
    },
    "afterLabel": {
      "type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"
    },
    "unit": {
      "type": "string", "maxLength": 4, "pattern": "^[^\\r\\n\\t]*$"
    },
    "rows": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "before", "after"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
          "before": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
          "after": {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
          "delta": {"type": "string", "maxLength": 6, "pattern": "^[^\\r\\n\\t]*$"}
        }
      }
    },
    "caption": {
      "type": "string", "maxLength": 28, "pattern": "^[^\\r\\n\\t]*$"
    }
  }
}
