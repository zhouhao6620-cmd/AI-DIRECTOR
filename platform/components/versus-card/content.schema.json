{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VersusCardContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["a", "b", "emphasis"],
  "properties": {
    "a": {"$ref": "#/$defs/side"},
    "b": {"$ref": "#/$defs/side"},
    "emphasis": {"enum": ["A", "B", "NONE"]}
  },
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "title", "sub"],
      "properties": {
        "kicker": {"type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
        "sub": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
      }
    }
  }
}
