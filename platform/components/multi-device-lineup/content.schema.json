{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MultiDeviceLineupContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["screen", "devices"],
  "properties": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rows"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 7, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
        "rows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
              "text": {"type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
          "kind": {"type": "string", "enum": ["phone", "tablet", "laptop"]},
          "label": {"type": "string", "minLength": 1, "maxLength": 8, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
        }
      }
    }
  }
}
