{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TermCardContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["term", "definition"],
  "properties": {
    "term": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
    "definition": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"},
    "en": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\r\\n\\t]*\\S[^\\r\\n\\t]*$"}
  }
}
