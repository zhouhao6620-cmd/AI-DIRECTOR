{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ComponentCapabilityIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "technical"],
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "name", "version", "title", "description", "tags", "aliases", "variants", "availability", "type", "pattern", "useCases", "minCardinality", "maxCardinality", "depth", "density", "contentSchemaRef"],
            "properties": {
              "componentId": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "variants": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}},
              "availability": {"type": "string", "enum": ["REGISTERED", "TEST_ONLY"]},
              "type": {"type": "string", "minLength": 1},
              "pattern": {"type": "string", "minLength": 1},
              "useCases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "minCardinality": {"type": "integer", "minimum": 1},
              "maxCardinality": {"type": "integer", "minimum": 1},
              "depth": {"type": "string", "minLength": 1},
              "density": {"type": "string", "minLength": 1},
              "contentSchemaRef": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revision", "generatedAt", "productionPolicy", "assetLibraryPolicy"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "revision": {"type": "string", "minLength": 1},
        "generatedAt": {"type": "string", "minLength": 1},
        "productionPolicy": {"type": "string", "const": "REGISTERED_ONLY"},
        "assetLibraryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "discoveryFields", "configurationOrder", "defaultAspectRatios", "previewMode", "globalSettings"],
          "properties": {
            "version": {"type": "string", "const": "1"},
            "discoveryFields": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "enum": ["title", "description", "tags", "aliases"]}},
            "configurationOrder": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "enum": ["VARIANT", "CONTENT", "APPEARANCE", "ANIMATION"]}},
            "defaultAspectRatios": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "enum": ["9:16", "16:9"]}},
            "previewMode": {"type": "string", "const": "PLAYER_CODE"},
            "globalSettings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "enum": ["PROJECT_THEME", "CANVAS_ASPECT_RATIO"]}}
          }
        }
      }
    }
  }
}
