{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CapabilityRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "capabilityName", "inputArtifactRefs", "projectContext", "requestedOutputSchema", "inputRevision"],
  "properties": {
    "runId": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "projectId": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "capabilityName": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "inputArtifactRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "projectContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baselineRef": {"type": "string"},
        "frozenRulesRef": {"type": "string"},
        "projectRulesRef": {"type": "string"}
      }
    },
    "requestedOutputSchema": {"type": "string", "minLength": 1},
    "inputRevision": {"type": "string", "minLength": 1}
  }
}
